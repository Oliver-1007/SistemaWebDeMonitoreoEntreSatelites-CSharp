@{
    ViewData["Title"] = "Privacidad";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-7">
        <div class="orb-card">
            <div class="orb-card-title">&#9632; Política de Privacidad</div>
            <p>
                OrbitNet-NetCore es un simulador académico desarrollado en el laboratorio del curso
                Introducción a la Programación y Computación II de la Facultad de Ingeniería,
                Universidad de San Carlos de Guatemala.
            </p>
            <p>
                Toda la información procesada por el sistema se almacena exclusivamente en memoria RAM
                durante la sesión activa del servidor. No se persisten datos en disco ni se comparten con
                servicios externos. Las comunicaciones inter-instancia utilizan HTTP Basic Authentication
                con credenciales de entorno controlado.
            </p>
            <p class="text-muted-orb mb-0" style="font-size:0.8rem;">
                Vigencia: Primer Semestre / Escuela de Vacaciones 2026 — ECYS
            </p>
        </div>
    </div>
</div>
